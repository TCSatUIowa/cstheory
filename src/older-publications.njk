---
layout: base.njk
title: Older publications
description: Publications by the University of Iowa CS Theory group from before 2017.
section: publications
permalink: /older-publications.html
---
<main id="main" class="people-page publications-page">
  <header class="people-heading">
    <div>
      <a class="group-back" href="./publications.html">← Publications</a>
      <h1>Older publications</h1>
    </div>
  </header>
  <p class="section-note">Publications from before 2017.</p>
  <div class="publication-years" data-year-max="2016">
    {% for group in publications.olderYears %}
    <section class="publication-year" aria-labelledby="year-{{ group.year }}">
      <h2 id="year-{{ group.year }}">{{ group.year }}</h2>
      <ul class="publication-list">
        {% for item in group.entries %}
        <li class="publication-entry">
          <h3>{% if item.link %}<a href="{{ item.link | escape }}">{{ item.title | escape }}</a>{% else %}{{ item.title | escape }}{% endif %}</h3>
          <p class="publication-authors">{{ item.authors | escape }}</p>
          <p class="publication-meta">{{ item.venue | escape }}{% if item.status %}<span class="publication-status">{{ item.status | escape }}</span>{% endif %}</p>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% else %}
    <p class="empty-events">No older publications to show.</p>
    {% endfor %}
  </div>
</main>
